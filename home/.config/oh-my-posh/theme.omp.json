{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "base": "#191724",
    "docker": "p:foam",
    "false": "p:love",
    "foam": "#9ccfd8",
    "git": "p:iris",
    "go": "p:rose",
    "gold": "#f6c177",
    "haskell": "p:rose",
    "highlight-high": "#524f67",
    "highlight-low": "#21202e",
    "highlight-med": "#403d52",
    "iris": "#c4a7e7",
    "julia": "p:rose",
    "love": "#eb6f92",
    "lua": "p:rose",
    "muted": "#6e6a86",
    "os-bg": "p:subtle",
    "os-fg": "p:base",
    "overlay": "#26233a",
    "path": "p:gold",
    "pine": "#31748f",
    "python": "p:rose",
    "root-bg": "p:gold",
    "root-fg": "p:base",
    "rose": "#ebbcba",
    "rust": "p:rose",
    "subtle": "#908caa",
    "surface": "#1f1d2e",
    "text": "#e0def4",
    "time": "p:muted",
    "true": "p:pine"
  },
  "transient_prompt": {
    "template": "{{ now | date \"15:04:05\" }} {{ if gt .Code 0 }}<p:false>❯</>{{ else }}<p:true>❯</>{{ end }} ",
    "foreground": "p:time"
  },
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "options": {
            "windows": "\ue70f"
          },
          "trailing_diamond": "\ue0b0",
          "template": " {{ .Icon }} ",
          "foreground": "p:os-fg",
          "background": "p:os-bg",
          "type": "os",
          "style": "diamond",
          "background_templates": [
            "{{ if .Root }}p:root-bg{{ end }}"
          ],
          "foreground_templates": [
            "{{ if .Root }}p:root-fg{{ end }}"
          ]
        },
        {
          "options": {
            "folder_icon": "..",
            "home_icon": "~",
            "style": "agnoster_short"
          },
          "template": " {{ .Path }} ",
          "foreground": "p:path",
          "type": "path",
          "style": "plain"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "options": {
            "branch_icon": "\ue725 ",
            "cherry_pick_icon": "\ue29b ",
            "commit_icon": "\uf417 ",
            "fetch_stash_count": false,
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "merge_icon": "\ue727 ",
            "no_commits_icon": "\uf0c3 ",
            "rebase_icon": "\ue728 ",
            "revert_icon": "\uf0e2 ",
            "tag_icon": "\uf412 "
          },
          "template": "{{ .HEAD }} ",
          "foreground": "p:git",
          "type": "git",
          "style": "plain"
        },
        {
          "template": "\uf308 {{ .Context }} ",
          "foreground": "p:docker",
          "type": "docker",
          "style": "plain"
        },
        {
          "template": "\ue627 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "p:go",
          "type": "go",
          "style": "plain"
        },
        {
          "template": "\ue620 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "p:lua",
          "type": "lua",
          "style": "plain"
        },
        {
          "options": {
            "display_default": false,
            "display_mode": "context"
          },
          "template": "\ue73c {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "p:python",
          "type": "python",
          "style": "plain"
        },
        {
          "options": {
            "style": "austin",
            "threshold": 500
          },
          "template": "\udb81\udd1f {{ .FormattedMs }} ",
          "foreground": "p:true",
          "type": "executiontime",
          "style": "plain",
          "foreground_templates": [
            "{{ if .Code }}p:false{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "options": {
            "always_enabled": true
          },
          "template": "❯ ",
          "foreground": "p:true",
          "type": "status",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:false{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "version": 2
}
